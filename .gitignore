# 依赖
node_modules/

# 构建产物（由 npm run build 生成，部署时用 tcb hosting deploy 上传）
app/dist/

# 日志 / 临时文件
*.log
*.tmp

# 测试运行器的缓存产物（vitest 每次跑都会改写，不该入库）
.vite/

# 流水线产物：全部可由 content/sources 或权威开源源重建，不入库
# （出题草稿人工修订后才用 gen-questions.mjs --merge 进题库）
content/raw/
content/corpus/
content/chunks/
content/drafts/
content/logs/
content/reports/

# 编辑器与系统
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# 后端/部署的机密与本地配置（会话密钥只在本地生成，绝不入库）
.secrets/
cloudbaserc.local.json
cloud/functions/*/node_modules/
app/.env.local
