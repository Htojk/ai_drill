#!/bin/sh
# 提交守门：行数预算（铁律 3）+ 分层与文件体积（铁律 1）+ 相关测试（铁律 4）
# 由 core.hooksPath 指向本目录启用：git config core.hooksPath .githooks
# 紧急绕过：git commit --no-verify（不要养成习惯，见 AGENTS.md 第 3 节）
#
# 注意：行数检查针对暂存内容，分层检查针对工作区文件（两者正常是一致的）。
# 更完整的门禁（含计划更新与收尾）请用 tools/finish-task.mjs。

set -e

node tools/check-commit-size.mjs --staged
node tools/check-layers.mjs

# 动了题库源数据或出题流水线，就跑一遍题库不变量校验（含每个错项的 wrongReason、来源原文片段）
if git diff --cached --name-only | grep -qE '^(app/src/data/questions/.*[.]json|tools/gen-questions[.]mjs)$'; then
  node tools/gen-questions.mjs --check
fi

# 铁律 4 的落地：只跑与本次暂存改动相关的测试（不是全量）。
# 没改动 app/src 下的代码/题库时，test-related 会直接跳过，不拖慢提交。
node tools/test-related.mjs

exit 0
